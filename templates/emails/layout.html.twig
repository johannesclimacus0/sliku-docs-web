<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <title>{% block title %}{{ appName }}{% endblock %}</title>
</head>
<body style="margin: 0; padding: 24px; background: #fafafa; color: #18181b; font-family: Arial, sans-serif; line-height: 1.6;">
    <div style="max-width: 560px; margin: 0 auto; padding: 24px; border: 1px solid #e4e4e7; background: white;">
        <p style="color: #71717a;">{{ appName }}</p>
        {% block content %}{% endblock %}
    </div>
</body>
</html>
