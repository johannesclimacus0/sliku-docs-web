{% extends 'emails/layout.html.twig' %}
{% block title %}Восстановление пароля{% endblock %}
{% block content %}
<p>Вы запросили новый пароль для {{ userEmail }}.</p>
<p><a href="{{ resetUrl }}">Задать новый пароль</a></p>
<p>Ссылка действует до {{ expiresAt|date('d.m.Y H:i', 'UTC') }} UTC.</p>
<p>Если вы не запрашивали восстановление, просто проигнорируйте письмо.</p>
{% endblock %}
