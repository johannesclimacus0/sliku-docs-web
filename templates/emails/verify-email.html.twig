{% extends 'emails/layout.html.twig' %}

{% block title %}Подтвердите email{% endblock %}

{% block content %}
    <h1 style="font-size: 24px;">Подтвердите email</h1>
    <p>Вы зарегистрировались с адресом <strong>{{ userEmail }}</strong>.</p>
    <p>
        <a href="{{ verificationUrl }}" style="display: inline-block; padding: 10px 16px; background: #18181b; color: white; text-decoration: none;">Подтвердить email</a>
    </p>
    <p>Ссылка действует до {{ expiresAt|date('d.m.Y H:i', 'UTC') }} UTC и может быть использована один раз.</p>
    <p style="color: #71717a;">Если вы не создавали аккаунт, проигнорируйте это письмо.</p>
{% endblock %}
