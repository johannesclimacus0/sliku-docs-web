#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';
Dotenv\Dotenv::createImmutable(dirname(__DIR__))->safeLoad();
if (!in_array('--force', $argv, true)) {
    fwrite(STDERR, "Usage: run fresh --force [--seed]. Deletes the public schema of the configured database.\n");
    exit(2);
}
$root = dirname(__DIR__);
$container = (require $root . '/config/container.php')();
$db = $container->get(Doctrine\ORM\EntityManagerInterface::class)->getConnection();
$db->transactional(static function ($db): void {
    $db->executeStatement('DROP SCHEMA public CASCADE');
    $db->executeStatement('CREATE SCHEMA public');
});
try {
    $container->get(Psr\Cache\CacheItemPoolInterface::class)->clear();
} catch (Throwable $error) {
    fwrite(STDERR, "Cache reset failed; check Redis and clear the application cache before continuing.\n");
    exit(1);
}
$process = proc_open([PHP_BINARY, $root . '/bin/doctrine', 'migrations:migrate', '--no-interaction'], [0 => STDIN, 1 => STDOUT, 2 => STDERR], $pipes, $root);
if (!is_resource($process)) {
    exit(1);
}
$code = proc_close($process);
if ($code !== 0) {
    exit($code);
}
if (in_array('--seed', $argv, true)) {
    exit(App\Console\ConsoleFactory::create()->run(new Symfony\Component\Console\Input\ArrayInput(['command' => 'db:seed'])));
}
echo "Fresh schema created.\n";
