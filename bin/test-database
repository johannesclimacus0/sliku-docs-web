#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

try {
    Tests\Support\TestDatabase::create();
    fwrite(STDOUT, 'Test database ready: ' . Tests\Support\TestDatabase::NAME . PHP_EOL);
} catch (Throwable $error) {
    fwrite(STDERR, 'Test database preparation failed: ' . $error->getMessage() . PHP_EOL);
    exit(1);
}
