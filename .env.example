APP_NAME="Workspace"
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=info

# Docker user; adjust to your host user if needed
UID=1000
GID=1000

# Keys are generated by ./run setup
JWT_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

REDIS_URL=redis://redis:6379
CACHE_NAMESPACE=app

DB_HOST=db
DB_PORT=5432
DB_CONNECT_TIMEOUT=3
DB_NAME=slim
DB_USER=slim
DB_PASSWORD=change-me

MAILER_DSN=smtp://mailpit:1025
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="Workspace"

FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL=3600

PASSWORD_RESET_TTL=1800

STORAGE_DISK=public
STORAGE_PUBLIC_URL=/media

WEBHOOK_USER_URL=
WEBHOOK_USER_SECRET=

DEMO_HTTP_URL=https://example.com

WEBHOOK_NOTIFICATION_URL=
WEBHOOK_NOTIFICATION_SECRET=

BROADCAST_ENABLED=false
BROADCAST_TOKEN_KEY=
BROADCAST_API_KEY=
BROADCAST_API_URL=http://centrifugo:8000
BROADCAST_WEBSOCKET_URL=ws://localhost:8000/connection/websocket
