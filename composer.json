{
    "require": {
        "php": "^8.5",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.8",
        "php-di/slim-bridge": "^3.4",
        "symfony/validator": "^8.1",
        "doctrine/orm": "^3.0",
        "doctrine/dbal": "^4.0",
        "symfony/cache": "^8.1",
        "doctrine/migrations": "^3.9",
        "vlucas/phpdotenv": "^5.7",
        "symfony/var-exporter": "^8.1",
        "symfony/expression-language": "^8.1",
        "psr/log": "^3",
        "monolog/monolog": "^3",
        "firebase/php-jwt": "^7.2",
        "symfony/rate-limiter": "^8.1",
        "symfony/lock": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/console": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/mailer": "^8.1",
        "twig/twig": "^3.30",
        "symfony/twig-bridge": "^8.1",
        "symfony/security-core": "^8.1",
        "league/flysystem": "^3",
        "league/flysystem-local": "^3",
        "symfony/http-client": "^8.1",
        "symfony/notifier": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\" : ["app/", "src/"]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\" : "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "itsgoingd/clockwork": "^5.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "symfony/tui": "^8.1",
        "symfony/process": "^8.1"
    }
